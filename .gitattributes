# Normalise line endings; keep LF in the repository and working tree.
* text=auto eol=lf

# Windows scripts need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files.
*.xlsx binary
*.xls binary
*.pdf binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary

# Vendored third-party code.
src/inventura/web/static/htmx.min.js linguist-vendored -diff
src/inventura/web/static/chart.umd.min.js linguist-vendored -diff
